{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Mobile Agent Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-mobile-agent"
      ],
      "outFiles": [
        "${workspaceFolder}/vscode-mobile-agent/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile"
    }
  ]
}
